#!/usr/bin/env bash
# Flash the firmware to an ESP32 board via the first detected USB port.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

detect_port() {
    local port
    port="$(ls /dev/tty.usbmodem* /dev/tty.usbserial* 2>/dev/null | head -1 || true)"
    if [ -z "$port" ]; then
        echo "error: no ESP32 serial port found (/dev/tty.usbmodem* or /dev/tty.usbserial*)" >&2
        exit 1
    fi
    echo "$port"
}

PORT="${IDF_PORT:-$(detect_port)}"
echo "Using port: ${PORT}"
exec "${SCRIPT_DIR}/idf" -p "${PORT}" flash